# Normalize line endings; let Git decide what is text.
* text=auto

# Unity YAML: keep these as text so diffs and merges are possible.
*.cs        text diff=csharp
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.anim      text
*.controller text
*.meta      text
*.shader    text

# Binary assets: never try to diff or merge these.
*.png  binary
*.jpg  binary
*.psd  binary
*.aseprite binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
